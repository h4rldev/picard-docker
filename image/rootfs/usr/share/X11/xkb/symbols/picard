// picard: a single layout holding the union of common Western-European
// symbols (Nordic, German, French, Spanish, Italian, Portuguese).
// The client browser resolves each key to its character (its own layout),
// noVNC sends that character as a keysym, and wayvnc maps the keysym to a
// key+level in this keymap. Physical key position is irrelevant, exactly
// like the TigerVNC stack the old docker-picard used. No per-user layout.
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us"
    include "level3(ralt_switch)"

    key.type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC";

    key <AC01> { [ a, A, agrave,        Agrave        ] };
    key <AC02> { [ s, S, adiaeresis,    Adiaeresis    ] };
    key <AC03> { [ d, D, aring,         Aring         ] };
    key <AC04> { [ f, F, eacute,        Eacute        ] };
    key <AC05> { [ g, G, egrave,        Egrave        ] };
    key <AC06> { [ h, H, ecircumflex,   Ecircumflex   ] };
    key <AC07> { [ j, J, ediaeresis,    Ediaeresis    ] };
    key <AC08> { [ k, K, idiaeresis,    Idiaeresis    ] };
    key <AC09> { [ l, L, odiaeresis,    Odiaeresis    ] };
    key <AC10> { [ semicolon, colon, oslash, Oslash   ] };
    key <AC11> { [ apostrophe, quotedbl, ae, AE       ] };

    key <AD01> { [ q, Q, acircumflex,   Acircumflex   ] };
    key <AD02> { [ w, W, ucircumflex,   Ucircumflex   ] };
    key <AD03> { [ e, E, udiaeresis,    Udiaeresis    ] };
    key <AD04> { [ r, R, icircumflex,   Icircumflex   ] };
    key <AD05> { [ t, T, ocircumflex,   Ocircumflex   ] };
    key <AD06> { [ y, Y, ugrave,        Ugrave        ] };
    key <AD07> { [ u, U, atilde,        Atilde        ] };
    key <AD08> { [ i, I, otilde,        Otilde        ] };
    key <AD09> { [ o, O, ntilde,        Ntilde        ] };
    key <AD10> { [ p, P, ccedilla,      Ccedilla      ] };
    key <AD11> { [ bracketleft, braceleft, ssharp, NoSymbol ] };

    key <AB01> { [ z, Z, aacute,        Aacute        ] };
    key <AB02> { [ x, X, iacute,        Iacute        ] };
    key <AB03> { [ c, C, oacute,        Oacute        ] };
    key <AB04> { [ v, V, uacute,        Uacute        ] };
    key <AB05> { [ b, B, yacute,        Yacute        ] };

    key <AE01> { [ 1, exclam,        exclamdown,    onesuperior    ] };
    key <AE02> { [ 2, at,            twosuperior,   guillemotleft  ] };
    key <AE03> { [ 3, numbersign,    threesuperior, guillemotright ] };
    key <AE04> { [ 4, dollar,        EuroSign,      sterling       ] };
    key <AE05> { [ 5, percent,       mu,            yen            ] };
    key <AE06> { [ 6, asciicircum,   section,       paragraph      ] };
    key <AE07> { [ 7, ampersand,     degree,        plusminus      ] };
    key <AE08> { [ 8, asterisk,      multiply,      division       ] };
    key <AE09> { [ 9, parenleft,     onequarter,    onehalf        ] };
    key <AE10> { [ 0, parenright,    threequarters, copyright      ] };
    key <AE11> { [ minus, underscore, endash,       emdash         ] };
    key <AE12> { [ equal, plus,      periodcentered, ellipsis      ] };
};